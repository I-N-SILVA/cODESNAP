	<string>CodeSnap does not use the camera.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>CodeSnap does not use the microphone.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>CodeSnap needs access to control keyboard shortcuts.</string>
	<key>NSAccessibilityUsageDescription</key>
	<string>CodeSnap needs accessibility access to register global keyboard shortcuts.</string>
	<key>NSSystemAdministrationUsageDescription</key>
	<string>CodeSnap may need administrative access to configure startup settings.</string>
	<key>NSUserNotificationUsageDescription</key>
	<string>CodeSnap sends notifications when screenshots are created or exported.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUPublicEDKey</key>
	<string></string>
	<key>SUFeedURL</key>
	<string>https://codesnap.app/appcast.xml</string>
