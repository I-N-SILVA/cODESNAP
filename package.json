{
  "name": "codesnap",
  "version": "1.0.0",
  "description": "Beautiful code screenshots - Electron app",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"tsc -w\" \"electron .\"",
    "build": "tsc && electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "package": "electron-builder --dir",
    "test": "jest",
    "icons": "node scripts/generate-icons.js",
    "postinstall": "npm run icons || echo 'Note: Run npm run icons after dependencies are installed'"
  },
  "keywords": [
    "code",
    "screenshot",
    "syntax-highlighting",
    "developer-tools"
  ],
  "author": "CodeSnap",
  "license": "MIT",
  "dependencies": {
    "electron-store": "^8.1.0",
    "highlight.js": "^11.9.0",
    "canvas": "^2.11.2",
    "sharp": "^0.33.0",
    "html2canvas": "^1.4.1",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11"
  },
  "build": {
    "appId": "com.codesnap.app",
    "productName": "CodeSnap",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "themes/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Development"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
